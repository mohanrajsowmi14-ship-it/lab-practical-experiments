#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50], n, head, disk;
    int i, j, temp, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk);

    /* Sort requests */
    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nSeek Sequence: %d", head);

    /* Move towards end */
    for (i = 0; i < n; i++)
    {
        if (request[i] >= head)
        {
            total += abs(head - request[i]);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    /* Move to end */
    total += abs(head - (disk - 1));
    head = disk - 1;
    printf(" -> %d", head);

    /* Jump to beginning */
    total += disk - 1;
    head = 0;
    printf(" -> %d", head);

    /* Continue in same direction */
    for (i = 0; i < n; i++)
    {
        if (request[i] < head)
        {
            total += abs(head - request[i]);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
