#include <stdio.h>

#define MAX 20

void firstFit(int block[], int nb, int process[], int np)
{
    int allocation[MAX], i, j;

    for (i = 0; i < np; i++)
        allocation[i] = -1;

    for (i = 0; i < np; i++)
    {
        for (j = 0; j < nb; j++)
        {
            if (block[j] >= process[i])
            {
                allocation[i] = j;
                block[j] -= process[i];
                break;
            }
        }
    }

    printf("\nFirst Fit:\n");
    for (i = 0; i < np; i++)
    {
        if (allocation[i] != -1)
            printf("Process %d -> Block %d\n", i + 1, allocation[i] + 1);
        else
            printf("Process %d -> Not Allocated\n", i + 1);
    }
}

void bestFit(int block[], int nb, int process[], int np)
{
    int allocation[MAX], i, j, best;

    for (i = 0; i < np; i++)
        allocation[i] = -1;

    for (i = 0; i < np; i++)
    {
        best = -1;

        for (j = 0; j < nb; j++)
        {
            if (block[j] >= process[i])
            {
                if (best == -1 || block[j] < block[best])
                    best = j;
            }
        }

        if (best != -1)
        {
            allocation[i] = best;
            block[best] -= process[i];
        }
    }

    printf("\nBest Fit:\n");
    for (i = 0; i < np; i++)
    {
        if (allocation[i] != -1)
            printf("Process %d -> Block %d\n", i + 1, allocation[i] + 1);
        else
            printf("Process %d -> Not Allocated\n", i + 1);
    }
}

void worstFit(int block[], int nb, int process[], int np)
{
    int allocation[MAX], i, j, worst;

    for (i = 0; i < np; i++)
        allocation[i] = -1;

    for (i = 0; i < np; i++)
    {
        worst = -1;

        for (j = 0; j < nb; j++)
        {
            if (block[j] >= process[i])
            {
                if (worst == -1 || block[j] > block[worst])
                    worst = j;
            }
        }

        if (worst != -1)
        {
            allocation[i] = worst;
            block[worst] -= process[i];
        }
    }

    printf("\nWorst Fit:\n");
    for (i = 0; i < np; i++)
    {
        if (allocation[i] != -1)
            printf("Process %d -> Block %d\n", i + 1, allocation[i] + 1);
        else
            printf("Process %d -> Not Allocated\n", i + 1);
    }
}

int main()
{
    int block[MAX], process[MAX];
    int b1[MAX], b2[MAX], b3[MAX];
    int nb, np, i;

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter size of each block:\n");
    for (i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter size of each process:\n");
    for (i = 0; i < np; i++)
        scanf("%d", &process[i]);

    for (i = 0; i < nb; i++)
    {
        b1[i] = block[i];
        b2[i] = block[i];
        b3[i] = block[i];
    }

    firstFit(b1, nb, process, np);
    bestFit(b2, nb, process, np);
    worstFit(b3, nb, process, np);

    return 0;
}
