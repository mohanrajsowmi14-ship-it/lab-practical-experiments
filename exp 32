#include <stdio.h>

int main()
{
    int pages[50], frames[10], recent[10];
    int n, f, i, j, k;
    int faults = 0, time = 0;
    int hit, pos, min;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter reference string:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
        recent[i] = 0;
    }

    for (i = 0; i < n; i++)
    {
        hit = 0;
        time++;

        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                hit = 1;
                recent[j] = time;
                break;
            }
        }

        if (!hit)
        {
            pos = -1;

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            if (pos == -1)
            {
                min = recent[0];
                pos = 0;

                for (k = 1; k < f; k++)
                {
                    if (recent[k] < min)
                    {
                        min = recent[k];
                        pos = k;
                    }
                }
            }

            frames[pos] = pages[i];
            recent[pos] = time;
            faults++;
        }

        printf("\n%d : ", pages[i]);

        for (j = 0; j < f; j++)
            printf("%d ", frames[j]);
    }

    printf("\n\nTotal Page Faults = %d\n", faults);

    return 0;
}
