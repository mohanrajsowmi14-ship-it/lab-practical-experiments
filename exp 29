#include <stdio.h>

int buffer[5];
int in = 0, out = 0;

void produce()
{
    int item;

    if ((in + 1) % 5 == out)
    {
        printf("Buffer is full\n");
        return;
    }

    printf("Enter item: ");
    scanf("%d", &item);

    buffer[in] = item;
    in = (in + 1) % 5;

    printf("Produced: %d\n", item);
}

void consume()
{
    int item;

    if (in == out)
    {
        printf("Buffer is empty\n");
        return;
    }

    item = buffer[out];
    out = (out + 1) % 5;

    printf("Consumed: %d\n", item);
}

int main()
{
    int choice;

    while (1)
    {
        printf("\n1. Produce\n2. Consume\n3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                produce();
                break;

            case 2:
                consume();
                break;

            case 3:
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }
}
