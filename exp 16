#include <stdio.h>

struct Employee
{
    int id;
    char name[30];
    float salary;
};

int main()
{
    FILE *fp;
    struct Employee emp;
    int choice, record;

    fp = fopen("employee.dat", "rb+");

    if (fp == NULL)
    {
        fp = fopen("employee.dat", "wb+");
    }

    while (1)
    {
        printf("\n--- EMPLOYEE RANDOM ACCESS FILE ---\n");
        printf("1. Add Employee\n");
        printf("2. Display Employee\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter Employee ID: ");
                scanf("%d", &emp.id);

                printf("Enter Employee Name: ");
                scanf("%s", emp.name);

                printf("Enter Salary: ");
                scanf("%f", &emp.salary);

                fseek(fp, (emp.id - 1) * sizeof(struct Employee), SEEK_SET);
                fwrite(&emp, sizeof(struct Employee), 1, fp);

                printf("Employee record saved successfully.\n");
                break;

            case 2:
                printf("Enter Employee ID to access: ");
                scanf("%d", &record);

                fseek(fp, (record - 1) * sizeof(struct Employee), SEEK_SET);

                if (fread(&emp, sizeof(struct Employee), 1, fp) == 1)
                {
                    printf("\nEmployee Details\n");
                    printf("ID     : %d\n", emp.id);
                    printf("Name   : %s\n", emp.name);
                    printf("Salary : %.2f\n", emp.salary);
                }
                else
                {
                    printf("Employee record not found.\n");
                }
                break;

            case 3:
                fclose(fp);
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
