#include <stdio.h>

int main()
{
    FILE *fp;
    char ch;

    /* Create and write */
    fp = fopen("sample.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be created\n");
        return 1;
    }

    fprintf(fp, "Hello, this is a file management program.\n");
    fclose(fp);

    /* Read */
    fp = fopen("sample.txt", "r");

    printf("File contents:\n");
    while ((ch = fgetc(fp)) != EOF)
        putchar(ch);

    fclose(fp);

    /* Append */
    fp = fopen("sample.txt", "a");
    fprintf(fp, "New line added to the file.\n");
    fclose(fp);

    printf("\nFile operations completed successfully.\n");

    return 0;
}
